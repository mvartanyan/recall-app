{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Recall",
  "version": "0.1.0",
  "identifier": "com.example.recall",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Recall",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 620,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "resources": {
      "../models/spkrec-ecapa-voxceleb.onnx": "models/spkrec-ecapa-voxceleb.onnx"
    },
    "macOS": {
      "frameworks": [],
      "minimumSystemVersion": "10.13",
      "infoPlist": "<key>NSMicrophoneUsageDescription</key><string>Recall needs microphone access to record audio.</string>"
    }
  }
}
